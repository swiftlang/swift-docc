# The Zip and ZLib sources are vendored from another repository, where their
# API is `public`. In this repository that API shouldn't be visible outside
# the package, so rewrite `public` to `package` (including `public import`).
#
# Re-run this script after updating the vendored sources.

set -eu

root="$(cd "$(dirname "$0")/.." && pwd)"

fd --type f --extension swift . "$root/Sources/Zip" "$root/Sources/ZLib" \
  --exec perl -pi -e 's/\bpublic\b/package/g'
