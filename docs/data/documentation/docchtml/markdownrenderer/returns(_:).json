        {
          "inlineContent" : [
            {
              "text" : "If each language representation of the symbol has its own language-specific return values, pass the return value content for all language representations.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "If all language representations of the symbol have the ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "same",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : " return value, only pass the return value content for one language.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "This produces a “returns” section that doesn’t hide the return value content for any of the languages (same as if the symbol only had one language representation)",
