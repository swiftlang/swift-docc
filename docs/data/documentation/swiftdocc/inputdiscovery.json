{
  "abstract" : [
    {
      "text" : "Learn how to discover documentation inputs on the file system.",
      "type" : "text"
    }
  ],
  "hierarchy" : {
    "paths" : [
      [
        "doc:\/\/SwiftDocC\/documentation\/SwiftDocC"
