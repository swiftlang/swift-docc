        {
          "inlineContent" : [
            {
              "text" : "If the variant type is a collection type, this property will also make sure that",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "any collection value, whether in the default value or any variant value, is non-empty.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "In other words, if a ",
              "type" : "text"
            },
            {
              "code" : "DocumentationDataVariants<[String]>",
              "type" : "codeVoice"
            },
            {
              "text" : " has a",
