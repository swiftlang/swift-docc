            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "default value of ",
              "type" : "text"
            },
            {
              "code" : "[]",
              "type" : "codeVoice"
            },
            {
              "text" : " and no variants, this property will still return false.",
              "type" : "text"
            }
          ],
