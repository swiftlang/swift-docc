      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "A file-system manager is a type that’s central to ",
              "type" : "text"
            },
            {
              "inlineContent" : [
                {
                  "text" : "managing",
                  "type" : "text"
                }
              ],
              "type" : "emphasis"
            },
            {
              "text" : " files on",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "a file-system, it performs actions like creating new files, copying, renaming",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "and deleting files, and organizing them in directories.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The Cocoa ",
              "type" : "text"
            },
            {
              "code" : "FileManager",
              "type" : "codeVoice"
            },
            {
              "text" : " type is the default implementation of that protocol",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "that manages files stored on disk.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Should you need a file system with a different storage, create your own",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "protocol implementations to manage files in memory,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "on a network, in a database, or elsewhere.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
